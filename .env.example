NODE_ENV=development
PORT=5000

# Saved clock, wages, collected money, and company. Defaults to ./data
# DATA_DIR=./data

# One paid hour, in milliseconds. Defaults to a real hour (3600000).
# HOUR_DURATION_MS=3600000

# Square. One business token. Each PC links to one team member on that account.
# Clock in opens that person's timecard. All wages add into the shared red number.
# A paid invoice prints +$200. A sent invoice gives 1 point.
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_TEAM_MEMBER_ID=
# SQUARE_ENVIRONMENT=production
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-host/api/square/webhook

# Shop clock (/punch) for 403 E Ben White Blvd. Defaults are that building.
# Employees send SHOP_PIN as x-shop-pin. It stays out of the client bundle.
# SHOP_PIN=
# GEO_FENCE_LAT=30.219778
# GEO_FENCE_LNG=-97.760707
# GEO_FENCE_RADIUS_M=120
# GEO_FENCE_MAX_ACCURACY_M=75
# GEO_FENCE_MAX_AGE_MS=30000
# GEO_FENCE_MAX_FUTURE_MS=15000

# Square Labor timecards for accepted shop punches. Off unless this is 1.
# The shop clock never sends a wage and never calls wage-setting.
# SQUARE_LABOR_PUNCHES=
