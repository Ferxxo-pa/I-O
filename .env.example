NODE_ENV=development
PORT=5000

# Saved clock, wages, collected money, and company. Defaults to ./data
# DATA_DIR=./data

# One paid hour, in milliseconds. Defaults to a real hour (3600000).
# HOUR_DURATION_MS=3600000

# Shop PIN for clock in, clock out, and settings. 4 to 8 digits.
# Stored only as a hash. Leave this unset to choose the PIN in Settings
# on the computer that created the company. A saved hash wins over this value.
# SHOP_PIN=

# Square. One business token. Each PC links to one team member on that account.
# Clock in opens that person's timecard. All wages add into the shared red number.
# A paid invoice prints +$200. A sent invoice gives 1 point.
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_TEAM_MEMBER_ID=
# SQUARE_ENVIRONMENT=production
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-host/api/square/webhook

# Presence punches. Each person has their own PIN. The shop fence is
# 403 E Ben White Blvd. Defaults are that building, 75m accuracy, 30s fix.
# GEO_FENCE_LAT=30.219778
# GEO_FENCE_LNG=-97.760707
# GEO_FENCE_RADIUS_M=120
# GEO_FENCE_MAX_ACCURACY_M=75
# GEO_FENCE_MAX_AGE_MS=30000
# PRESENCE_ARRIVE_START=06:00
# PRESENCE_ARRIVE_END=12:00
# PRESENCE_LUNCH_START=11:00
# PRESENCE_LUNCH_END=14:00
# PRESENCE_MIN_AWAY_MS=600000
# PRESENCE_OPEN=09:00
# PRESENCE_CLOSE=17:00
# PRESENCE_DAY_CLOSE=19:00
# PRESENCE_CLOSE_GRACE_MS=7200000
# I'm here without a GPS fix is accepted only with this token, on the shop computer.
# PRESENCE_DESK_TOKEN=
# Square mirror for accepted punches. Unset or "dry" plans timecards and writes nothing.
# "live" sends them. It never sends an hourly rate. Square keeps the wage.
# SQUARE_PRESENCE_MIRROR=dry
