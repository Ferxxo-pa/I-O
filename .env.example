NODE_ENV=development
PORT=5000

# Saved clock, wages, collected money, and company. On the spare computer
# this must be a disk that survives a reboot. Defaults to ./data
# DATA_DIR=/var/lib/io

# 127.0.0.1 on the spare computer, so only the tunnel on that machine can
# connect. Leave unset on Fly or Railway (they need 0.0.0.0).
# HOST=127.0.0.1

# Nightly copy of DATA_DIR. A second disk or a USB drive. The Ready check
# stays green for 36 hours after a successful copy.
# BACKUP_DIR=/mnt/backup/io
# Optional second copy, such as a private folder that syncs to the cloud.
# BACKUP_CLOUD_DIR=
# BACKUP_MAX_AGE_MS=129600000

# Browser origins allowed to call this server. Unset or * allows any origin.
# The shop PIN and the phone bearer token are still required.
# IO_CORS_ORIGINS=*

# Bake this only when the strip is built on a different host than the server.
# Leave it unset when the server itself serves the strip. Employees open
# https://your-host/?join=CODE and that host is the server.
# VITE_IO_SERVER_URL=

# One paid hour, in milliseconds. Defaults to a real hour (3600000).
# HOUR_DURATION_MS=3600000

# Shop PIN for clock in, clock out, and settings. 4 to 8 digits.
# Stored only as a hash. Leave this unset to choose the PIN in Settings
# on the computer that created the company. A saved hash wins over this value.
# SHOP_PIN=

# Square. One business token. Each PC links to one team member on that account.
# Clock in opens that person's timecard. All wages add into the shared red number.
# A paid invoice prints +$200. A sent invoice gives 1 point.
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_TEAM_MEMBER_ID=
# SQUARE_ENVIRONMENT=production
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-host/api/square/webhook

# Presence punches. Each person has their own PIN. The shop fence is
# 403 E Ben White Blvd. Defaults are that building, 75m accuracy, 30s fix.
# GEO_FENCE_LAT=30.219778
# GEO_FENCE_LNG=-97.760707
# GEO_FENCE_RADIUS_M=120
# GEO_FENCE_MAX_ACCURACY_M=75
# GEO_FENCE_MAX_AGE_MS=30000
# PRESENCE_ARRIVE_START=06:00
# PRESENCE_ARRIVE_END=12:00
# PRESENCE_LUNCH_START=11:00
# PRESENCE_LUNCH_END=14:00
# PRESENCE_MIN_AWAY_MS=600000
# PRESENCE_OPEN=09:00
# PRESENCE_CLOSE=17:00
# PRESENCE_DAY_CLOSE=19:00
# PRESENCE_CLOSE_GRACE_MS=7200000
# Shop streak and week. A day counts when this many people are on the clock
# together, from accepted punches, Chicago time. Default 1. Early and late
# punches still count. 9–5 is not a cutoff.
# PRESENCE_SHOP_DAY_MIN_PEOPLE=1
# Optional minutes that overlap must last. Unset means no minute minimum
# (with the default of 1 person, any accepted arrival counts).
# PRESENCE_SHOP_DAY_MIN_MINUTES=
# I'm here without a GPS fix is accepted only with this token, on the shop computer.
# PRESENCE_DESK_TOKEN=
# Square mirror for accepted punches. Unset or "dry" plans timecards and writes nothing.
# "live" sends them. It never sends an hourly rate. Square keeps the wage.
# SQUARE_PRESENCE_MIRROR=dry

# Phone automations. The public https origin is what the setup snippet tells
# Shortcuts and MacroDroid to call. See docs/presence-phone-automations.md.
# PRESENCE_PUBLIC_URL=https://your-host
# No trusted automatic signal for this long starts a leave. Default 15 minutes.
# PRESENCE_SIGNAL_QUIET_MS=900000
# Local time after which a still-open signal day closes. Default 7:00 PM Chicago.
# PRESENCE_AUTO_CLOSE=19:00
# Optional watcher and geofence timestamps. Default 2 minutes old, 15 seconds ahead.
# PRESENCE_SIGNAL_MAX_AGE_MS=120000
# PRESENCE_SIGNAL_MAX_FUTURE_MS=15000
# Automatic signals per IP per minute.
# PRESENCE_SIGNAL_RATE_PER_MIN=60
# Automatic signals only from open minus this through close plus this. Default 2 hours.
# PRESENCE_COLLECT_MARGIN_MS=7200000
# A phone or watcher still present this long, or overnight, stops counting.
# PRESENCE_STATIONARY_MS=50400000
# PRESENCE_OVERNIGHT_EDGE_MS=1800000
# Phone automation timestamps, when the body includes ts. Default 10 minutes.
# PRESENCE_PHONE_MAX_AGE_MS=600000
# Same phone event inside this window is a retry. Default 2 minutes.
# PRESENCE_PHONE_DEDUPE_MS=120000
# Optional router watcher and BLE stub. Empty BLE stays off.
# PRESENCE_WIFI_HMAC_SECRET=
# PRESENCE_BLE_HMAC_SECRET=
# PRESENCE_BLE_ENABLED=
# Required in production before a Wi-Fi or BLE id is stored. HMAC pepper, not the MAC.
# PRESENCE_DEVICE_HASH_PEPPER=
